{
  "version": 1,
  "main_branch": "main",
  "branch_prefix": "work/",
  "loop": {
    "cap": 5,
    "fail_review_cap": 10
  },
  "token_log": true,
  "token_log_path": ".autodeliver/token_log.csv",
  "paths": {
    "handoff": "docs/delivery/HANDOFF.md",
    "decisions": "docs/delivery/DECISIONS_LOG.md",
    "roadmap": "docs/delivery/ROADMAP.md",
    "ledgers": "docs/delivery/ledgers/",
    "plans": "docs/delivery/plans/",
    "evidence": "docs/delivery/evidence/",
    "host_doc": "docs/delivery/HOST.md"
  },
  "project": "Acme Portal (Azure DevOps)",
  "mode": "cloud",
  "host": "ado",
  "profiles": [
    "software"
  ],
  "repo": "acme/Portal/portal",
  "marker_prefix": "ACME",
  "label": "acme-review-fail",
  "proof_full": [
    "npm test",
    "npx tsc --noEmit",
    "npm run lint",
    "npm run build"
  ],
  "proof_touched": [
    "npx vitest related --run",
    "npx tsc --noEmit"
  ],
  "e2e": "npx playwright test",
  "locales": [
    "en",
    "ar"
  ],
  "staging": {
    "client": "tools/stg.sh",
    "test_account_domain": "example.com"
  },
  "gates": [
    "Production deploy needs the owner's approval in chat"
  ],
  "ado": {
    "org": "https://dev.azure.com/acme",
    "project": "Portal",
    "repo": "portal",
    "git_name": "Delivery Bot",
    "git_email": "delivery@acme.example",
    "reports_branch": "delivery-reports"
  }
}
