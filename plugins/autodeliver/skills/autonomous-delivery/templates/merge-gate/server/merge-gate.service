[Unit]
Description=Merge gate: merge Worker PRs whose current head has the review gate's PASS
Documentation=file:///opt/merge-gate/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/merge-gate/token.env

[Service]
Type=oneshot
User=merge-gate
Group=merge-gate
# systemd reads both files as root before it drops to the service user, so the user can't read the token.
EnvironmentFile=/etc/merge-gate/config.env
EnvironmentFile=/etc/merge-gate/token.env
ExecStart=/usr/bin/python3 -I /opt/merge-gate/merge_gate.py
TimeoutStartSec=120
MemoryMax=96M
CPUQuota=25%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
